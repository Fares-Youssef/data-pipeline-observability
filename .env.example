# Copy to .env and fill in the local MySQL/MariaDB account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=depi_app
DB_PASSWORD=
DB_NAME=depi
DB_CONNECT_TIMEOUT=5
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
REVERSE_DIAGNOSTICS=false
OPEN_METEO_API_KEY=
WEATHER_REQUEST_TIMEOUT=30
WEATHER_BATCH_SIZE=25
WEATHER_REQUEST_INTERVAL=3
WEATHER_RATE_LIMIT_BACKOFF=30
WEATHER_MAX_LOCATIONS=0
LOG_LEVEL=INFO
DB_SSL_CA=
DB_SSL_VERIFY_CERT=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=weather-raw

